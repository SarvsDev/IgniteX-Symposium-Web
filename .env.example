# Supabase server-side credentials
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Supabase browser credentials
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Admin authentication (server-side only)
ADMIN_SECRET_KEY=CHANGE_THIS_TO_A_STRONG_SECRET

# Gmail SMTP (use a Google App Password, NOT your normal Gmail password)
GMAIL_SMTP_USER=your-sending-account@gmail.com
GMAIL_SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_SMTP_FROM_NAME=IgniteX 2026

# Optional application URL used in verification links
APP_URL=https://y
