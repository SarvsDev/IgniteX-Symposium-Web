# SERVER-ONLY — never expose these with VITE_
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=IgniteX 2026 <onboarding@resend.dev>
ADMIN_SECRET_KEY=YOUR_ADMIN_SECRET_KEY
APP_URL=http://localhost:3000
PORT=3000

# PUBLIC FRONTEND VALUES — safe to expose in Vite
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional while Resend domain is unverified
RESEND_TEST_MODE=false
# Required only when RESEND_TEST_MODE=true
RESEND_TEST_RECIPIENT=
