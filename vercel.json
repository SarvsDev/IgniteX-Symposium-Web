{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/register.ts": {
      "maxDuration": 60
    },
    "api/[...path].ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/", "destination": "/index.html" },
    { "source": "/register", "destination": "/index.html" },
    { "source": "/register/:path*", "destination": "/index.html" }
  ]
}
